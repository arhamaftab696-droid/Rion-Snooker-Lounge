#!/bin/bash
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"

if [[ "$DIR" == *"Desktop"* ]]; then
    DIR="/Users/arhamaftab/Documents/system"
fi

cd "$DIR"

# Force native Apple Silicon arm64 execution to avoid Rosetta warnings
ARCH_CMD=""
if [[ "$(uname -m)" == "arm64" ]]; then
    ARCH_CMD="arch -arm64"
fi

if [ -f "./venv/bin/python" ]; then
    PY="./venv/bin/python"
else
    PY="python3"
fi

# Run background server if needed
if ! pgrep -f "server.py" > /dev/null; then
    $ARCH_CMD $PY server.py > /tmp/transaction_web.log 2>&1 &
fi

# Run Desktop App
$ARCH_CMD $PY app.py > /tmp/transaction_app.log 2>&1
